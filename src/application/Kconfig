choice
    prompt "Component"
    default ADVICTOR_ENABLE

    config ADVICTOR_ENABLE
        bool
        prompt "Enable advictor component."
        help
            This option means support advictor components.

    if ADVICTOR_ENABLE
        osource "application/advictor/Kconfig"
    endif

    config SAMPLE_ENABLE
        bool
        prompt "Enable Sample."
        help
            This option means support Samples.

    if SAMPLE_ENABLE
        osource "application/samples/Kconfig"
    endif

endchoice
