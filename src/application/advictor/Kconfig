config ENABLE_WIFI_STA
    bool
    prompt "Enable wifi station."
    default y
    depends on ADVICTOR_ENABLE
    help
        This option means enable the wifi station.

if ENABLE_WIFI_STA
    osource "application/advictor/wifi_sta/Kconfig"
endif
