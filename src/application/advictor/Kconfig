config ENABLE_GATEWAY
    bool
    prompt "Enable gateway."
    default y
    depends on ADVICTOR_ENABLE
    help
        This option means enable the gateway.

if ENABLE_GATEWAY
    osource "application/advictor/gateway/Kconfig"
endif
